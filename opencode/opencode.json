			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"qwen3-coder-next": {
					"name": "qwen3-coder-next"
				},
				"qwen3-coder-next:q8_0": {
					"name": "qwen3-coder-next:q8_0"
				},
				"qwen3.8:27b": {
					"name": "qwen3.8:27b"
				},
				"qwen3.6:35b": {
					"name": "qwen3.6:35b"
				}
			}
		}
	}
}
