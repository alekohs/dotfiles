{
	"$schema": "https://opencode.ai/config.json",
	"theme": {
		"name": "ayu",
		"mode": "system"
	},
	"autoupdate": true,
	"permission": {
		"edit": "ask",
		"bash": "ask",
		"skill": "ask",
		"webfetch": "deny",
		"doom_loop": "ask",
		"external_directory": "ask"
	},
	"provider": {
