{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;198;143;99",
      "2": "38;2;168;159;149",
      "3": "38;2;142;96;61",
      "4": "38;2;245;245;245",
      "5": "38;2;154;163;172"
    },
    "padding": {
      "top": 2,
      "left": 2,
      "right": 5
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 14
    },
    "color": {
      "keys": "38;2;198;143;99",
      "output": "38;2;214;217;221",
      "title": "38;2;245;245;245",
      "separator": "38;2;96;88;82"
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 10
    },
    "percent": {
      "type": 1,
      "color": {
        "green": "38;2;168;159;149",
        "yellow": "38;2;198;143;99",
        "red": "38;2;211;109;105"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#38;2;245;245;245}{user-name}{#38;2;96;88;82}@{#38;2;198;143;99}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;96;88;82}──────────────────────────────────────────────{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;168;159;149}01{#}  {#1;38;2;245;245;245}SYSTEM{#}"
    },
    {
      "type": "os",
      "key": "    os"
    },
    {
      "type": "kernel",
      "key": "    kernel"
    },
    {
      "type": "uptime",
      "key": "    uptime"
    },
    {
      "type": "packages",
      "key": "    packages"
    },
    {
      "type": "shell",
      "key": "    shell"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;168;159;149}02{#}  {#1;38;2;245;245;245}HARDWARE{#}"
    },
    {
      "type": "host",
      "key": "    host"
    },
    {
      "type": "cpu",
      "key": "    cpu"
    },
    {
      "type": "gpu",
      "key": "    gpu"
    },
    {
      "type": "memory",
      "key": "    memory",
      "format": "{used} / {total}  {percentage-bar} {percentage}"
    },
    {
      "type": "disk",
      "key": "    disk",
      "folders": "/",
      "format": "{size-used} / {size-total}  {size-percentage-bar} {size-percentage}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;168;159;149}03{#}  {#1;38;2;245;245;245}SESSION{#}"
    },
    {
      "type": "wm",
      "key": "    wm"
    },
    {
      "type": "terminal",
      "key": "    terminal"
    },
    {
      "type": "localip",
      "key": "    local ip",
      "showIpv4": true,
      "compact": true
    },
    {
      "type": "display",
      "key": "    display"
    },
    {
      "type": "custom",
      "format": "{#38;2;96;88;82}──────────────────────────────────────────────{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;154;163;172}alekoh.se{#}"
    }
  ]
}
