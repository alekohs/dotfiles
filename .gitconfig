[merge]
    tool = nvimdiff3
    conflictstyle = diff3
[mergetool]
    keepBackup = false
[mergetool "nvimdiff3"]
    cmd = "nvim --cmd 'let g:nvim_merge = 1' -d \"$MERGED\" -M \"$LOCAL\" \"$BASE\" \"$REMOTE\" -c \"lua require('config.merge').setup()\""
    trustExitCode = true
[core]
    excludesfile = ~/.gitignore_global
[init]
    defaultBranch = main
[gpg]
    format = ssh
[commit]
    gpgSign = true
[tag]
    gpgSign = true
[alias]
    dl = -c diff.external=difft log --ext-diff
    ds = -c diff.external=difft show --ext-diff
    dft = -c diff.external=difft diff
